---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	retriever(retriever)
	draft(draft)
	review(review)
	cancel(cancel)
	__end__([<p>__end__</p>]):::last
	__start__ --> retriever;
	draft -. &nbsp;end&nbsp; .-> __end__;
	draft -.-> review;
	retriever -. &nbsp;end&nbsp; .-> __end__;
	retriever -.-> draft;
	review -. &nbsp;done&nbsp; .-> __end__;
	review -.-> cancel;
	review -.-> draft;
	cancel --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
